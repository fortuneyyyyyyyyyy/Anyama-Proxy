{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://anyama-proxy.onrender.com/api/:path*" },
    { "source": "/admin", "destination": "https://anyama-proxy.onrender.com/admin" },
    { "source": "/admin/:path*", "destination": "https://anyama-proxy.onrender.com/admin/:path*" },
    { "source": "/static/:path*", "destination": "https://anyama-proxy.onrender.com/static/:path*" },
    { "source": "/health", "destination": "https://anyama-proxy.onrender.com/health" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }] }
  ]
}
